DB_URL=
DB_SCHEMA=fast_shop
FASTSHOP_ENV=production
FASTSHOP_HOST=0.0.0.0
FASTSHOP_PORT=5025
FASTSHOP_PUBLIC_URL=https://shop.fastsme.com
# Set to 1 only when launching public signup.
FASTSHOP_SIGNUP_OPEN=0
FASTSHOP_SESSION_SECRET=
FASTSHOP_ENCRYPTION_KEY=
FASTSHOP_AUTO_CREATE_SCHEMA=0
FASTSHOP_ADMIN_EMAIL=
FASTSHOP_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Any OpenAI-compatible chat completions endpoint; these take precedence over XAI_*.
MODEL_BASE_URL=
MODEL_API_KEY=
FASTSME_API_TOKEN=
FASTERP_BASE_URL=https://erp.fastsme.com
FASTERP_API_TOKEN=
FASTSHOP_CONNECTOR_TOKEN=
FASTERP_COMPANY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com

# Custom domains (Settings -> Domains). See docs/CUSTOM_DOMAINS.md.
FASTSHOP_INGRESS_IPV4=
FASTSHOP_DOMAIN_CNAME_TARGET=
FASTSHOP_AUTOMATIC_TLS=0
# Automatic HTTPS on Coolify: connected store domains are added to this app (docs/CUSTOM_DOMAINS.md).
FASTSHOP_COOLIFY_URL=
FASTSHOP_COOLIFY_TOKEN=
FASTSHOP_COOLIFY_APP_UUID=
FASTSHOP_COOLIFY_KEEP_DOMAINS=
