DB_URL=
DB_SCHEMA=fast_shop
FASTSHOP_ENV=production
FASTSHOP_HOST=0.0.0.0
FASTSHOP_PORT=5025
FASTSHOP_PUBLIC_URL=https://shop.fastsme.com
# Set to 1 only when launching public signup.
FASTSHOP_SIGNUP_OPEN=0
FASTSHOP_SESSION_SECRET=
FASTSHOP_ENCRYPTION_KEY=
FASTSHOP_AUTO_CREATE_SCHEMA=0
FASTSHOP_ADMIN_EMAIL=
FASTSHOP_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
FASTSME_API_TOKEN=
FASTERP_BASE_URL=https://erp.fastsme.com
FASTERP_API_TOKEN=
FASTSHOP_CONNECTOR_TOKEN=
FASTERP_COMPANY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com

# H24YOU Liquid demo cutover. Unset/empty leaves hostnames and access unchanged.
# This also copies Kinetic tenant membership roles and enables sandbox customer accounts.
FASTSHOP_H24YOU_LIQUID_HOSTNAME=h24you.fastsme.com
# Show the merchant password form for existing per-user password hashes.
FASTSHOP_ALLOW_PASSWORD_LOGIN=1
# Keep FASTSHOP_PUBLIC_URL on the platform host, not the demo hostname above.
# Retain the existing stored/session/encryption credentials in Coolify.
FASTSHOP_ENABLE_SCHEDULER=0
FASTSHOP_IMAGE_PROVIDER=placeholders
# Optional live-store encryption and platform billing are unnecessary for this demo.
FASTSHOP_STORE_KEY_ENCRYPTION_KEY=
FASTSHOP_BILLING_STRIPE_SECRET_KEY=
FASTSHOP_BILLING_STRIPE_WEBHOOK_SECRET=
FASTSHOP_BILLING_PRICE_BASIC=
FASTSHOP_BILLING_PRICE_PRO=
FASTSHOP_BILLING_LIVE_ACCEPTED=0
