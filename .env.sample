# Runtime
FASTSHOP_ENV=development
FASTSHOP_HOST=0.0.0.0
FASTSHOP_PORT=5025
FASTSHOP_PUBLIC_URL=http://localhost:5025
FASTSHOP_SESSION_SECRET=
FASTSHOP_ENCRYPTION_KEY=
FASTSHOP_DATA_DIR=data
FASTSHOP_AUTO_CREATE_SCHEMA=1
DB_URL=
DB_SCHEMA=fast_shop

# Local login (disabled in production unless both values are explicitly set)
FASTSHOP_ADMIN_EMAIL=admin@fastshop.example
FASTSHOP_ADMIN_PASSWORD=FastShop2026$

# Google authorization-code OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5025/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# AI assistant
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Integrations
FASTSME_API_TOKEN=
FASTERP_BASE_URL=https://erp.fastsme.com
FASTERP_API_TOKEN=
FASTSHOP_CONNECTOR_TOKEN=
FASTERP_COMPANY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com
