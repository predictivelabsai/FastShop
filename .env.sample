# Runtime
FASTSHOP_ENV=development
FASTSHOP_HOST=0.0.0.0
FASTSHOP_PORT=5025
FASTSHOP_PUBLIC_URL=http://localhost:5025
# Set to 1 only when launching public signup.
FASTSHOP_SIGNUP_OPEN=0
FASTSHOP_SESSION_SECRET=
FASTSHOP_ENCRYPTION_KEY=
FASTSHOP_DATA_DIR=data
FASTSHOP_AUTO_CREATE_SCHEMA=1
DB_URL=
DB_SCHEMA=fast_shop

# Local login (disabled in production unless both values are explicitly set)
FASTSHOP_ADMIN_EMAIL=admin@fastshop.example
FASTSHOP_ADMIN_PASSWORD=FastShop2026$

# Google authorization-code OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5025/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# AI assistant
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Any OpenAI-compatible chat completions endpoint; these take precedence over XAI_*.
# Stores connect their own key under Settings, AI assistant. This platform key is only
# the operator fallback for stores without one, and the site generator's key.
MODEL_BASE_URL=
MODEL_API_KEY=
# At least 32 characters. Encrypts store-managed connections, including each store's own
# assistant model key. Without it, stores cannot save their own keys.
FASTSHOP_STORE_KEY_ENCRYPTION_KEY=
# Set to 1 to let stores without their own assistant key use the platform MODEL_API_KEY.
FASTSHOP_ASSISTANT_PLATFORM_FALLBACK=

# Integrations
FASTSME_API_TOKEN=
FASTERP_BASE_URL=https://erp.fastsme.com
FASTERP_API_TOKEN=
FASTSHOP_CONNECTOR_TOKEN=
FASTERP_COMPANY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com
